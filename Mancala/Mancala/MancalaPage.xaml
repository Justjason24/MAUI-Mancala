<?xml version="1.0" encoding="utf-8" ?>
<!-- TODO: Remove WidthRequest and HeeightRequest when using emulator -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             WidthRequest="360"
             HeightRequest="640"
             xmlns:local="clr-namespace:Mancala"
             x:Class="Mancala.MancalaPage">


    <!-- Mancala Board -->
    <Grid RowDefinitions="Auto, *, Auto"
            ColumnDefinitions="*"
            Padding="20"
            x:Name="MancalaBoardLayout"
            BackgroundColor="#84240c"
            HorizontalOptions="Center"
            VerticalOptions="Center">


        <!-- Top bank -->
        <Border
            Grid.Row="0"
            HeightRequest="80"
            WidthRequest="250"
            Background="#ffc18c"
            Stroke="Black"
            StrokeThickness="2"
            StrokeShape="RoundRectangle 30"/>

        <!-- Pebble pools 2x6 -->
        <Grid Grid.Row="1"
                  ColumnSpacing="10"
                  Padding="10"
                  RowSpacing="10"
                  RowDefinitions="*,*,*,*,*,*"
                  ColumnDefinitions="*,*"
                  x:Name="PitsGrid">



            <!--<Ellipse x:Name="Pit00" Grid.Row="0" Grid.Column="0" Fill="#ffc18c" HeightRequest="60" WidthRequest="60" />-->
            <Grid x:Name="Pit00Container" Grid.Row="0" Grid.Column="0"
                    HeightRequest="60" WidthRequest="60">
                <!-- pit background -->
                <GraphicsView>
                    <GraphicsView.Drawable>
                        <local:PitDrawable />
                    </GraphicsView.Drawable>
                </GraphicsView>
                <!-- pebbles! -->
                <GraphicsView x:Name="Pit00">
                    <GraphicsView.Drawable>
                        <local:PebbleDrawable PebbleCount="4" />
                    </GraphicsView.Drawable>
                </GraphicsView>
            </Grid>

            <Grid x:Name="Pit10Container" Grid.Row="1" Grid.Column="0"
