<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mancala.TestPageWithInteraction"
             xmlns:local="clr-namespace:Mancala.Dev"
             Title="TestPageWithInteraction">

    <Grid>
        <Grid.GestureRecognizers>
            <PointerGestureRecognizer PointerPressed="OnPointerPressed" />
        </Grid.GestureRecognizers>
        
        <GraphicsView x:Name="MyGameScreen">
            <GraphicsView.Drawable>
                <local:BallDrawableInteraction/>
            </GraphicsView.Drawable>
        </GraphicsView>
    </Grid>
</ContentPage>