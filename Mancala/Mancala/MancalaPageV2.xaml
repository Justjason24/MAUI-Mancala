<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mancala.MancalaPageV2"
             xmlns:local="clr-namespace:Mancala"
             >


    <Grid RowDefinitions="Auto, *, Auto"
          ColumnDefinitions="*"
          Padding="20"
          BackgroundColor="PaleGoldenrod">

        <Border
            Grid.Row="0"
            HeightRequest="80"
            WidthRequest="250"
            Background="#ffc18c"
            Stroke="Black"
            StrokeThickness="2"
            StrokeShape="RoundRectangle 30">

            <!-- Pebbles will live in this layout because a Border can only have one child element -->
            <HorizontalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="6">

                <!--mocking pebbles--> 
                <Ellipse WidthRequest="16" HeightRequest="16" Fill="SaddleBrown"/>
                <Ellipse WidthRequest="16" HeightRequest="16" Fill="SaddleBrown"/>
                <Ellipse WidthRequest="16" HeightRequest="16" Fill="SaddleBrown"/>

            </HorizontalStackLayout>

        </Border>


    </Grid>

</ContentPage>